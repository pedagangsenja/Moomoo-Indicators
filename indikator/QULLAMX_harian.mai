M10:=MA(CLOSE,10);
M20:=MA(CLOSE,20);
E10:=EMA(CLOSE,10);
ADR:=MAX(100*(MA(HIGH/LOW,20)-1),0.01);
CLV:=(CLOSE-LOW)/(HIGH-LOW+0.0001);
TRENDOK:=M10>M20 AND M10>REF(M10,1) AND M20>REF(M20,1);
G3:=CLOSE/LLV(CLOSE,63);
MOM:=IF(G3>=1.3,4,IF(G3>=1.15,2,0));
SURF:=IF(CLOSE>E10 AND TRENDOK,4,IF(CLOSE>M20 AND M20>REF(M20,1),2,0));
RK:=((HHV(HIGH,6)-LLV(LOW,6))/CLOSE*100)/ADR;
KETAT:=IF(RK<=1.5,4,IF(RK<=2.5,2,0));
VK:=MA(VOL,5)/MA(VOL,50);
KERING:=IF(VK<=0.7,4,IF(VK<=0.9,2,0));
ADRS:=IF(ADR>=5,4,IF(ADR>=3.5,2,0));
SKOR:=MOM+SURF+KETAT+KERING+ADRS;
TINGGI:=MAX(SKOR,1);
GAP:=(OPEN/REF(CLOSE,1)-1)*100;
RVOL:=VOL/REF(MA(VOL,50),1);
ABAI:=REF(CLOSE,1)/REF(CLOSE,63)<1.2;
EPX:=GAP>=8 AND RVOL>=3 AND ABAI AND CLV>=0.5;
BUY:=EPX AND REF(EPX,1)=0;
SEJAK:=BARSLAST(BUY);
HENTI:=VALUEWHEN(BUY,LOW);
KSTOP:=LOW<=HENTI AND SEJAK>=1;
KTRAIL:=CLOSE<M20 AND SEJAK>=1;
KELUAR:=KSTOP OR KTRAIL;
PERTAMA:=KELUAR AND BUY=0 AND BARSLAST(REF(KELUAR,1))>=SEJAK;
STOP1:=PERTAMA AND KSTOP;
SELL1:=PERTAMA AND KSTOP=0;
HIJAU:=TRENDOK AND SKOR>=14;
KUNING:=HIJAU=0 AND TRENDOK AND SKOR>=8;
MERAH:=HIJAU=0 AND KUNING=0;
STICKLINE(1,0,20,1,0),COLOR263238;
STICKLINE(HIJAU,0,TINGGI,1,0),COLOR00C853;
STICKLINE(KUNING,0,TINGGI,1,0),COLORFFB300;
STICKLINE(MERAH,0,TINGGI,1,0),COLORE53935;
DRAWTEXT(BUY,-2,'▲'),COLOR00E5FF;
DRAWTEXT(BUY,3,'BUY'),COLORWHITE;
DRAWTEXT(SELL1,25,'▼'),COLORWHITE;
DRAWTEXT(SELL1,22,'SELL'),COLORWHITE;
DRAWTEXT(STOP1,25,'▼'),COLORFF1744;
DRAWTEXT(STOP1,22,'STOP'),COLORFF1744;
